[Unit]
Description=Synapse Agent (observe-only)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/synapse-agent run --config /etc/synapse-agent/config.json
Restart=always
RestartSec=5
User=root
WorkingDirectory=/var/lib/synapse-agent
# Hardening: the agent is observe-only and never needs new privileges.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
