// Headscale ACL — v1.19+ tag-based defaults.
//
// Two tags own every node in this tailnet:
//   - tag:synapse-control → the Synapse central VPS (control plane).
//                            Owns the API key + SSH'es into remote hosts
//                            to dispatch docker commands.
//   - tag:synapse-remote  → a host added via Admin → Hosts → Setup
//                            remote install. Receives docker exec calls
//                            from the control plane on port 22.
//
// Both tags are owned by the synapse Headscale user (the namespace
// every Synapse-minted pre-auth key uses). Operators MUST NOT mint
// keys with these tags from outside Synapse — the dashboard's
// remote_setup endpoint is the only sanctioned mint path.
//
// Default policy: least-privilege. The control plane reaches remote
// hosts on (a) port 22 for the Docker command-dispatch channel and
// (b) the deployment host-port range so the central proxy can route
// /d/<name>/* HTTP traffic to remote Convex containers over the
// tailnet. Remote hosts have NO blanket ability to talk to each other
// or back to the control plane — if a future feature needs
// cross-remote networking (replicated services, gossip, etc.) it MUST
// land its own scoped ACL entry rather than reverting to *.
//
// To customize: operators MAY edit this file at
// $INSTALL_DIR/headscale/policy.hujson and restart the headscale
// container. The installer never overwrites an existing policy file
// (see headscale::render_config in installer/install/headscale.sh).
{
  // Headscale 0.28 policy v2: tag owners MUST be a user reference
  // ending in "@" (Headscale users have no domain, so it's the bare
  // name + "@"), a "group:" alias, or a "tag:". A bare "synapse"
  // is rejected at startup with "Invalid Owner" and the container
  // crash-loops. v1.19.0/.1 shipped the bare form; v1.19.2 fixed it.
  "tagOwners": {
    "tag:synapse-control": ["synapse@"],
    "tag:synapse-remote":  ["synapse@"]
  },
  "acls": [
    // Control plane → remote hosts, SSH (Docker command dispatch).
    {
      "action": "accept",
      "src":    ["tag:synapse-control"],
      "dst":    ["tag:synapse-remote:22"]
    },
    // Control plane → remote hosts, deployment host-port range. The
    // central proxy (/d/<name>/*) reaches each remote Convex container
    // on its dynamically-allocated host_port over the tailnet; without
    // this the proxy times out ("context canceled") and remote
    // deployments are unreachable. The range matches the allocator's
    // SYNAPSE_PORT_RANGE_MIN..MAX (defaults 3210-3500); an operator who
    // narrows that range MAY tighten this dst to match.
    {
      "action": "accept",
      "src":    ["tag:synapse-control"],
      "dst":    ["tag:synapse-remote:3210-3500"]
    }
  ]
}
