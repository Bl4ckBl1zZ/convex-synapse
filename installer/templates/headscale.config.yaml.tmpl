# Headscale v0.28.0 config — generated by setup.sh.
# See: https://github.com/juanfont/headscale/blob/v0.28.0/config-example.yaml
#
# This file is rendered fresh on every install/reconfigure. Manual edits
# survive ONLY when re-running setup.sh "reconfigure --keep-headscale-config"
# (not implemented yet) — plan to back up before editing by hand.

# server_url is what Tailscale clients POST to during `tailscale up
# --login-server=...`. MUST be the externally-reachable URL of the
# Headscale instance: subdomain when SYNAPSE_BASE_DOMAIN is set,
# else host_ip:port for --no-tls installs.
server_url: {{SYNAPSE_HEADSCALE_SERVER_URL}}

# Inside the container the HTTP API listens on 0.0.0.0:8080. Caddy
# proxies external HTTPS traffic into it; no direct host-port mapping
# in TLS mode. In --no-tls mode the compose file publishes 8080 on
# the host (see SYNAPSE_HEADSCALE_PORT).
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

# DERP relays via Tailscale's managed mesh — NAT-traversal fallback
# only; identity + control plane stay self-hosted in our Headscale.
derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 24h

# Database: dedicated 'headscale' database on Synapse's Postgres
# cluster. Headscale auto-migrates on startup.
database:
  type: postgres
  postgres:
    host: postgres
    port: 5432
    name: {{SYNAPSE_HEADSCALE_DB_NAME}}
    user: {{SYNAPSE_HEADSCALE_DB_USER}}
    pass: {{SYNAPSE_HEADSCALE_DB_PASSWORD}}
    ssl: "disable"

# Caddy terminates TLS for us — Headscale stays plain HTTP internally.
tls_cert_path: ""
tls_key_path: ""

log:
  level: info
  format: text

# ACL policy (file mode — reload via SIGHUP or container restart).
# We ship a permissive default; operators tighten via the dashboard
# in a future release.
policy:
  mode: file
  path: /etc/headscale/policy.hujson

# MagicDNS: keep OFF for v1.18.0. Adds DNS complexity that isn't
# required for the SSH-based provisioning flow (Synapse uses
# tailnet IPs directly, not hostnames). Operators can enable later.
#
# Headscale 0.28+ rejects the config at startup with
#   "dns.nameservers.global must be set when dns.override_local_dns is true"
# because override_local_dns defaults to TRUE. We don't want to push
# DNS resolvers onto remote VPSs (would break their existing setups)
# so set override_local_dns: false explicitly.
dns:
  magic_dns: false
  override_local_dns: false

enable_check_updates: false
ephemeral_node_inactivity_timeout: 30m
