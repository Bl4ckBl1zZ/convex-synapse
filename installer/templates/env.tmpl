# Synapse — generated by setup.sh. Edit by hand only if you know why.
#
# This file is rendered by installer/install/secrets.sh on first
# install (the curly-brace tokens below are placeholder names that
# the renderer substitutes with values from exported env vars). On
# subsequent runs, existing values are preserved and new keys are
# appended (Coolify-style update_env_var).

# --- Server ---
SYNAPSE_HTTP_ADDR=0.0.0.0:8080
SYNAPSE_LOG_LEVEL=info

# --- Database ---
SYNAPSE_DB_URL=postgres://{{POSTGRES_USER}}:{{POSTGRES_PASSWORD}}@postgres:5432/{{POSTGRES_DB}}?sslmode=disable

# --- Auth ---
# Access TTL = 24h is the dev-tool ergonomic default (operators leave
# dashboards open all day); refresh TTL = 30d is the real session length.
# Tighten ACCESS_TTL (e.g. 1h) if your compliance posture requires more
# frequent re-authentication — the dashboard auto-refreshes silently so
# operators don't see a /login bounce during normal use.
SYNAPSE_JWT_SECRET={{SYNAPSE_JWT_SECRET}}
SYNAPSE_JWT_ACCESS_TTL=24h
SYNAPSE_JWT_REFRESH_TTL=720h

# --- Provisioning ---
SYNAPSE_DOCKER_HOST=unix:///var/run/docker.sock
# v1.7.1+: pinned upstream tag. Bump in lock-step with the same value
# in docker-compose.yml, installer/install/lifecycle.sh, setup.sh,
# synapse/internal/config/config.go, and .github/workflows/ci.yml.
SYNAPSE_BACKEND_IMAGE=ghcr.io/get-convex/convex-backend@sha256:19481d5e9309db4a87a9a2e9d12a6930bd12569e1fc96276d9fa0aae53a106b6
SYNAPSE_DOCKER_NETWORK=synapse-network
SYNAPSE_PORT_RANGE_MIN=3210
SYNAPSE_PORT_RANGE_MAX=3500

# --- Reverse proxy ---
SYNAPSE_PROXY_ENABLED=true

# --- Public URL (REQUIRED for VPS / production) ---
# When set, /v1/deployments/{name}/cli_credentials returns a URL the
# remote operator can reach. Empty = local-dev (the legacy
# 127.0.0.1:port URL is what local CLIs need).
SYNAPSE_PUBLIC_URL={{SYNAPSE_PUBLIC_URL}}

# --- Dashboard host domain (set by --domain) ---
# The control plane's own hostname (e.g. synapse.example.com). Read by
# the Headscale server-URL resolver (-> headscale.<SYNAPSE_DOMAIN>) and
# the custom-domain / tls_ask flow. Empty on IP-only (--no-tls) installs.
SYNAPSE_DOMAIN={{SYNAPSE_DOMAIN}}

# --- Custom domains (v1.0+, optional) ---
# When set, deployment URLs become "https://<name>.<BASE_DOMAIN>"
# instead of "<PublicURL>/d/<name>". Operator points wildcard DNS
# (*.<BASE_DOMAIN> A record -> VPS IP) and Caddy on-demand TLS
# issues per-host certs lazily.
#
# HTTP actions (Better Auth /api/auth/*, webhooks, /engine/*) are served
# on the deployment's SITE host "<name>.site.<BASE_DOMAIN>" (Convex port
# 3211). That needs a SECOND wildcard A record: *.site.<BASE_DOMAIN> ->
# VPS IP. Without it, login/webhooks 404 from outside. See
# docs/CONVEX_SITE_ORIGIN.md.
#
# Empty disables the feature; the path-based proxy at /d/<name>/*
# keeps working unchanged.
SYNAPSE_BASE_DOMAIN={{SYNAPSE_BASE_DOMAIN}}

# --- Public IP (v1.6.6+, REQUIRED for per-deployment custom domains) ---
# IPv4 the operator publishes in DNS for custom domains added on
# /v1/deployments/{name}/domains. Without it the dashboard shows
# "DNS verification disabled" and rows stay 'pending' forever.
# secrets::ensure_env autodetects via api.ipify.org when empty, so
# fresh installs / upgrades / reconfigure top-up automatically.
SYNAPSE_PUBLIC_IP={{SYNAPSE_PUBLIC_IP}}

# --- CORS ---
# Restrict to the dashboard origin once you go behind TLS.
SYNAPSE_ALLOWED_ORIGINS={{SYNAPSE_ALLOWED_ORIGINS}}

# --- Healthcheck path (don't change unless you know why) ---
SYNAPSE_HEALTHCHECK_VIA_NETWORK=true

# --- HA (v0.5+, optional) ---
# When ENABLE_HA was passed at install (--enable-ha or wizard "y"),
# setup.sh generates HA_PG_PASSWORD + HA_S3_KEY + HA_S3_SECRET and
# wires SYNAPSE_BACKEND_* to point at the bundled cluster-pg + minio
# services that come up under `--profile ha`. This is local-bundle HA:
# real Postgres + S3 backing per deployment, but on the SAME host —
# better than single-replica SQLite, not "multi-node high availability".
# Operators with their own managed Postgres + S3 can override the
# SYNAPSE_BACKEND_* values here after install; the bundled services
# stay idle when the `ha` compose profile isn't activated.
SYNAPSE_HA_ENABLED={{SYNAPSE_HA_ENABLED}}
SYNAPSE_STORAGE_KEY={{SYNAPSE_STORAGE_KEY}}
SYNAPSE_BACKEND_POSTGRES_URL={{SYNAPSE_BACKEND_POSTGRES_URL}}
SYNAPSE_BACKEND_S3_ENDPOINT={{SYNAPSE_BACKEND_S3_ENDPOINT}}
SYNAPSE_BACKEND_S3_REGION={{SYNAPSE_BACKEND_S3_REGION}}
SYNAPSE_BACKEND_S3_ACCESS_KEY={{SYNAPSE_BACKEND_S3_ACCESS_KEY}}
SYNAPSE_BACKEND_S3_SECRET_KEY={{SYNAPSE_BACKEND_S3_SECRET_KEY}}
SYNAPSE_BACKEND_S3_BUCKET_PREFIX={{SYNAPSE_BACKEND_S3_BUCKET_PREFIX}}

# --- HA bundled services (cluster-pg + minio under --profile ha) ---
# These seed the backend-postgres + minio containers from
# docker-compose.yml. Same value flows into SYNAPSE_BACKEND_* above so
# synapse-api can reach the bundled services from inside the
# synapse-network. Empty when ENABLE_HA wasn't passed.
HA_PG_USER={{HA_PG_USER}}
HA_PG_PASSWORD={{HA_PG_PASSWORD}}
HA_S3_KEY={{HA_S3_KEY}}
HA_S3_SECRET={{HA_S3_SECRET}}

# --- Aster runtime bridge (experimental, optional) ---
# Aster brokerd stays on the memory-store smoke path when these are empty.
# Set POSTGRES_URL to a Convex Postgres database and MODULES_DIR to the
# Docker-host path containing module bundle .blob files (the modules dir
# itself, not the storage root).
SYNAPSE_ASTER_POSTGRES_URL=
SYNAPSE_ASTER_DB_SCHEMA=public
SYNAPSE_ASTER_MODULES_DIR=

# --- Postgres (compose-only, seeds the metadata DB container) ---
POSTGRES_USER={{POSTGRES_USER}}
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_DB={{POSTGRES_DB}}
POSTGRES_PORT={{POSTGRES_PORT}}

# --- Compose host ports ---
SYNAPSE_PORT={{SYNAPSE_PORT}}
DASHBOARD_PORT={{DASHBOARD_PORT}}
CONVEX_DASHBOARD_PORT={{CONVEX_DASHBOARD_PORT}}
PUBLIC_SYNAPSE_URL={{SYNAPSE_PUBLIC_URL}}
PUBLIC_CONVEX_DASHBOARD_URL={{PUBLIC_CONVEX_DASHBOARD_URL}}
SYNAPSE_VERSION={{SYNAPSE_VERSION}}

# --- Self-update daemon (v1.5.1+) ---
# TCP localhost + bearer token. The synapse-api container reaches the
# daemon via host.docker.internal:8089 (extra_hosts in compose). The
# token is generated once at install time and preserved on every
# subsequent re-render — DO NOT regenerate or every running synapse-api
# loses its credential.
SYNAPSE_UPDATER_PORT={{SYNAPSE_UPDATER_PORT}}
SYNAPSE_UPDATER_TOKEN={{SYNAPSE_UPDATER_TOKEN}}
SYNAPSE_UPDATER_URL={{SYNAPSE_UPDATER_URL}}

# --- Cell Control Plane (v1.12+) ---
# observe/plan-only. Apply is hard-disabled (SYNAPSE_AGENT_APPLY=false)
# — the synapse-agent only inspects and reports. See
# docs/CELL_CONTROL_PLANE.md and docs/SAFETY_INVARIANTS.md.
# SYNAPSE_REGION: short region code used when auto-creating Cells
# (e.g. "eu-west-1"). Empty falls back to "local".
SYNAPSE_ENABLE_CELLS=true
SYNAPSE_REGION=
SYNAPSE_AGENT_STALE_AFTER_SECONDS=60
SYNAPSE_AGENT_OFFLINE_AFTER_SECONDS=300
SYNAPSE_ENABLE_DESIRED_STATE=true
SYNAPSE_ENABLE_OBSERVED_STATE=true
SYNAPSE_ENABLE_RECONCILE_DRY_RUN=true
SYNAPSE_AGENT_APPLY=false

# --- Health worker (optional) ---
# When "true", the health worker promotes 'stopped' containers back to
# 'running' via docker start. Empty / "false" keeps it observe-only.
# Leave empty unless you've thought about the restart-loop scenarios.
SYNAPSE_HEALTH_AUTO_RESTART=

# --- Meta / dashboard upstream (advanced) ---
# SYNAPSE_GITHUB_REPO: where the auto-updater fetches /releases/latest.
# Override only for forks. SYNAPSE_DASHBOARD_UPSTREAM and
# SYNAPSE_DASHBOARD_SHELL_UPSTREAM are the service names the in-process
# reverse proxy proxies to; override only if you renamed services in
# docker-compose.yml.
SYNAPSE_GITHUB_REPO=Iann29/convex-synapse
SYNAPSE_DASHBOARD_UPSTREAM=synapse-convex-dashboard-proxy:80
SYNAPSE_DASHBOARD_SHELL_UPSTREAM=synapse-dashboard:3000

# --- Headscale (v1.18+, Remote Hosts) ---
# Activated by `setup.sh --enable-headscale` (or operator manually
# flipping the `headscale` compose profile on). Powers VPSes added
# via install-agent.sh: clients register at SYNAPSE_HEADSCALE_SERVER_URL,
# get a tailnet IP in 100.64.0.0/10, and Synapse central reaches
# them via that IP for SSH-based docker provisioning.
#
# SYNAPSE_HEADSCALE_URL is the URL the synapse-api container uses to
# call Headscale's HTTP API (internal docker-network address —
# http://synapse-headscale:8080). SYNAPSE_HEADSCALE_SERVER_URL is
# the EXTERNAL URL Tailscale clients hit during `tailscale up
# --login-server=...` — that one ends up in
# $INSTALL_DIR/headscale/config.yaml as `server_url:`.
#
# Empty SYNAPSE_HEADSCALE_URL disables the integration entirely
# (Synapse-API treats Remote Hosts as not configured).
SYNAPSE_HEADSCALE_URL={{SYNAPSE_HEADSCALE_URL}}
SYNAPSE_HEADSCALE_API_KEY={{SYNAPSE_HEADSCALE_API_KEY}}
SYNAPSE_HEADSCALE_SERVER_URL={{SYNAPSE_HEADSCALE_SERVER_URL}}
SYNAPSE_HEADSCALE_DB_NAME={{SYNAPSE_HEADSCALE_DB_NAME}}
SYNAPSE_HEADSCALE_DB_USER={{SYNAPSE_HEADSCALE_DB_USER}}
SYNAPSE_HEADSCALE_DB_PASSWORD={{SYNAPSE_HEADSCALE_DB_PASSWORD}}
