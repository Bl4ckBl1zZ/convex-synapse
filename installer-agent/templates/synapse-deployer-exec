#!/usr/bin/env bash
# synapse-deployer-exec — forced-command wrapper for the synapse-deployer
# SSH user. The SSH client (Synapse central) sends a command via
# `ssh synapse-deployer@<tailnet-ip> docker run ...`; sshd parses that
# into SSH_ORIGINAL_COMMAND and execs THIS script instead.
#
# We parse $SSH_ORIGINAL_COMMAND and exec ONLY the whitelisted Docker
# subcommands. Anything else (rm -rf /, /bin/sh, sudo, etc) gets a
# hard EPERM with audit log.
#
# Whitelist rationale: provisioning a Convex deployment needs
# docker run, stop, rm, start, restart, inspect, ps, logs. Phase 3
# will tighten this further with per-argv validation; for now we
# accept any args after the subcommand and rely on the synapse-deployer
# user having only docker group (no sudo).
#
# Test mode: set SYNAPSE_DEPLOYER_EXEC_TEST=1 to short-circuit the
# final exec and print the would-be argv instead. Used by bats so we
# can exercise the whitelist without an actual docker on the test box.
set -Eeuo pipefail

ALLOWED=(run stop rm start restart inspect ps logs version)

log_audit() {
    if command -v logger >/dev/null 2>&1; then
        logger -t synapse-deployer-exec -p auth.notice "$*" || true
    fi
}

cmd_string="${SSH_ORIGINAL_COMMAND:-}"
if [[ -z "$cmd_string" ]]; then
    log_audit "refused: empty SSH_ORIGINAL_COMMAND from ${SSH_CLIENT:-unknown}"
    echo "synapse-deployer-exec: empty command" >&2
    exit 99
fi

# Strict parse: split on whitespace into argv.
read -ra argv <<<"$cmd_string"

if [[ "${argv[0]:-}" != "docker" ]]; then
    log_audit "refused: not a docker command from ${SSH_CLIENT:-unknown}: ${argv[*]}"
    echo "synapse-deployer-exec: only docker commands allowed" >&2
    exit 99
fi

subcmd="${argv[1]:-}"
allowed=false
for a in "${ALLOWED[@]}"; do
    if [[ "$subcmd" == "$a" ]]; then
        allowed=true
        break
    fi
done

if ! $allowed; then
    log_audit "refused: subcommand '$subcmd' not in whitelist from ${SSH_CLIENT:-unknown}"
    echo "synapse-deployer-exec: subcommand '$subcmd' not permitted" >&2
    exit 99
fi

# Log + exec. Logged at auth.notice so the operator can audit later.
log_audit "exec: ${argv[*]} from ${SSH_CLIENT:-unknown}"

if [[ -n "${SYNAPSE_DEPLOYER_EXEC_TEST:-}" ]]; then
    printf 'would-exec: %s\n' "${argv[*]}"
    exit 0
fi

exec "${argv[@]}"
