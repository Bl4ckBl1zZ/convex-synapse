# /etc/sudoers.d/synapse-deployer-teardown
# Generated by install-agent.sh — do not edit (re-run install-agent.sh to update).
#
# Grants the synapse-deployer SSH user exactly ONE privileged action:
# running the root-owned teardown script when the operator deletes this
# host from the Synapse control plane. The script is root-owned and NOT
# writable by synapse-deployer, the path is absolute, and no arguments are
# permitted — so this is a single tightly-scoped escalation, NOT a general
# sudo grant. Everything else the deployer can do still flows through the
# docker-only synapse-deployer-exec wrapper with no sudo.
{{SSH_USER}} ALL=(root) NOPASSWD: /usr/local/bin/synapse-agent-teardown
